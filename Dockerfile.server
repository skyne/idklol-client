# syntax=docker/dockerfile:1
#
# UE Dedicated Server Docker image - Multi-stage build
#
# Stage 1: Build the dedicated server using Unreal Engine
# Stage 2: Package into a lightweight runtime container

# ===== BUILD STAGE =====
FROM ghcr.io/epicgames/unreal-engine:dev-5.5 AS builder

# The UE path in Epic's container - typically /home/ue4/UnrealEngine
ENV UE_ROOT=/home/ue4/UnrealEngine
ENV PROJECT_ROOT=/home/ue4/project

# Perform filesystem setup as root
USER root

WORKDIR ${PROJECT_ROOT}

# Ensure build and trace directories are writable for the ue4 user
RUN mkdir -p ${PROJECT_ROOT}/LinuxServerPackage \
    /home/ue4/UnrealEngine/UnrealTrace/Store && \
    chown -R ue4:ue4 ${PROJECT_ROOT} /home/ue4/UnrealEngine/UnrealTrace

# Run Unreal build steps as ue4
USER ue4

# Copy the project files and set ownership to ue4 user
COPY --chown=ue4:ue4 . ${PROJECT_ROOT}/

# Build the editor first (needed for cooking)
RUN ${UE_ROOT}/Engine/Build/BatchFiles/Linux/Build.sh \
    TPSCoreMechanicsEditor Linux Development \
    ${PROJECT_ROOT}/TPSCoreMechanics.uproject \
    -waitmutex

# Build the dedicated server
RUN ${UE_ROOT}/Engine/Build/BatchFiles/Linux/Build.sh \
    TPSCoreMechanicsServer Linux Development \
    ${PROJECT_ROOT}/TPSCoreMechanics.uproject \
    -waitmutex

# Cook, package, and archive the server
# Use iterative cooking and skip DDC, disable shader compilation distributed builds
RUN ${UE_ROOT}/Engine/Build/BatchFiles/RunUAT.sh BuildCookRun \
    -project=${PROJECT_ROOT}/TPSCoreMechanics.uproject \
    -platform=Linux \
    -serverconfig=Development \
    -server \
    -noclient \
    -cook \
    -stage \
    -pak \
    -archive \
    -archivedirectory=${PROJECT_ROOT}/LinuxServerPackage/LinuxServer \
    -noP4 \
    -nodebuginfo \
    -allmaps \
    -SkipCookingEditorContent \
    -build \
    -noxge \
    -NoShaderDistrib \
    -unattended \
    -utf8output \
    -ddc=Noshared \
    -nullrhi

# ===== RUNTIME STAGE =====
FROM ubuntu:22.04 AS runtime

# UE server runtime deps (glibc, ssl, threads, libcurl)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libssl3 \
        libcurl4 \
        ca-certificates \
        libc6 \
        libstdc++6 \
        libgcc-s1 && \
    rm -rf /var/lib/apt/lists/*

# Unreal server must not run as root
RUN useradd -m -u 1000 -s /bin/bash ue4

WORKDIR /game

# Copy the packaged Linux dedicated server from build stage
COPY --from=builder /home/ue4/project/LinuxServerPackage/LinuxServer/ /game/

# Make the launch script executable
RUN chmod +x /game/TPSCoreMechanicsServer.sh 2>/dev/null || true && \
    find /game -name "*.so" -exec chmod +x {} \; && \
    chown -R ue4:ue4 /game

USER ue4

# Game port (UDP) — default UE port 7777. BeaconPort = 7787.
EXPOSE 7777/udp
EXPOSE 7778/udp
EXPOSE 7787/udp

# Environment-driven configuration
ENV MAP_PATH="/Game/ThirdPerson/Maps/ThirdPersonMap"
ENV GAME_PORT="7777"
ENV NATS_URL="nats://nats:4222"
ENV INSTANCE_ID=""
ENV LOG_LEVEL="Log"

CMD ["/bin/sh", "-c", \
    "/game/TPSCoreMechanicsServer.sh \
    ${MAP_PATH} \
    -log \
    -port=${GAME_PORT} \
    -NATSUrl=${NATS_URL} \
    ${INSTANCE_ID:+-InstanceId=${INSTANCE_ID}} \
    -stdout \
    -FullStdOutLogOutput"]
